# Environment Variables for just-prompt

# Generic OpenAI-compatible or multi-protocol model gateway.
MODEL_GATEWAY_BASE_URL=https://your-gateway.example.com/v1
MODEL_GATEWAY_PROTOCOL_BASE_URL=https://your-gateway.example.com
MODEL_GATEWAY_API_KEY=your_gateway_api_key_here

# File tools default to the server's current working directory.
# Uncomment to allow prompt_from_file*, prompt_from_file_to_file, and ceo_and_board
# to read/write inside a different directory root.
# JUST_PROMPT_FILE_ROOT=/absolute/path/to/allowed/workspace

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Ollama endpoint (if not default)
OLLAMA_HOST=http://localhost:11434
